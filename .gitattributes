# Normalize line endings and stop CRLF churn.
# `* text=auto` lets Git normalize files it detects as text; the explicit
# rules below pin the canonical ending per file type (LF for sources,
# CRLF for Windows batch files, binary for anything Git must not touch).

* text=auto

*.kt         text eol=lf
*.kts        text eol=lf
*.cpp        text eol=lf
*.h          text eol=lf
*.md         text eol=lf
*.json       text eol=lf
*.xml        text eol=lf
*.ini        text eol=lf
*.properties text eol=lf
*.sh         text eol=lf

*.bat        text eol=crlf
gradlew.bat  text eol=crlf

*.png        binary
*.jar        binary
